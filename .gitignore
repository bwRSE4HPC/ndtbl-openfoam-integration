# Ignore everything but 'files' and 'options' directories in solver
applications/solver/bwRSE4HPCFoam/Make/*/

# Ignore everything but 'files' and 'options' directories in combustionModels
src/combustionModels/Make/*/
src/combustionModels/lnInclude/

# Ignore tutorial results and log files
tutorials/**/log.*
tutorials/**/dynamicCode/
tutorials/D3TransCube/0/
tutorials/D3TransCube/benchmark-results/
tutorials/D3TransCube/constant/polyMesh/
tutorials/D3TransCube/constant/*_table
tutorials/D3TransCube/processor*/
tutorials/D3TransCube/tables/

# ndtbl binary files
*.ndtbl

# Ignore heaptrack output files
*.zst

# OpenFoam case files
*.foam
