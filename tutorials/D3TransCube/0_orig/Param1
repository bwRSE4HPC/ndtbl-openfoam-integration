FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      Param1;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inlet
    {
        type            uniformFixedValue;
        uniformValue
        {
            type        linearRamp;
            start       0;
            duration    0.1;
        }
    }
    outlet
    {
        type            zeroGradient;
    }
    chamber
    {
        type            zeroGradient;
    }
}


