#!/bin/bash
# Load OpenFOAM run functions
. $WM_PROJECT_DIR/bin/tools/RunFunctions

CASE_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"

# User settings, overridable through environment variables
TABLERESOLUTION="${TABLERESOLUTION:-51}"      # select table resolution (2, 21, 31, 41, 46, 51)
PARALLEL="${PARALLEL:-true}"                  # parallel mode?
NPROCS="${NPROCS:-4}"                         # number of MPI ranks when parallel
TABLES_DIR="${TABLES_DIR:-$CASE_DIR/tables/tables_${TABLERESOLUTION}}"

if [[ "$TABLES_DIR" != /* ]]; then
    TABLES_DIR="$CASE_DIR/$TABLES_DIR"
fi

for table_name in Table1_table Table2_table Table3_table Table4_table; do
    if [ ! -e "$TABLES_DIR/$table_name" ]; then
        echo "Missing baseline table file: $TABLES_DIR/$table_name" >&2
        exit 1
    fi
done

# Link tables
ln -sf "$TABLES_DIR/Table1_table" "$CASE_DIR/constant/Table1_table"
ln -sf "$TABLES_DIR/Table2_table" "$CASE_DIR/constant/Table2_table"
ln -sf "$TABLES_DIR/Table3_table" "$CASE_DIR/constant/Table3_table"
ln -sf "$TABLES_DIR/Table4_table" "$CASE_DIR/constant/Table4_table"

# Copy initial conditions
cp -rf 0_orig 0

# Create Mesh
runApplication blockMesh

if [ "$PARALLEL" = true ]; then
    sed -i "s/^numberOfSubdomains[[:space:]].*;/numberOfSubdomains $NPROCS;/" \
        system/decomposeParDict

    # Decompose case
    runApplication decomposePar

    # Run solver in parallel
    runApplication mpirun -np "$NPROCS" bwRSE4HPCFoam -parallel

    # Reconstruct results
    runApplication reconstructPar

    # Remove processor directories
    rm -rf processor*
else
    # Serial run
    runApplication bwRSE4HPCFoam
fi
